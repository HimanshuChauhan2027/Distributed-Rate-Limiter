# Copy to .env and edit. Docker Compose reads .env automatically.

RATE_LIMIT_ALGORITHM=FIXED_WINDOW
# Options: FIXED_WINDOW | SLIDING_WINDOW | TOKEN_BUCKET

RATE_LIMIT_MAX_REQUESTS=10
# Fixed/Sliding Window: max requests per window
# Token Bucket: bucket capacity (max burst size)

RATE_LIMIT_WINDOW_SECONDS=10
# Fixed/Sliding Window only

RATE_LIMIT_REFILL_PER_SEC=1.0
# Token Bucket only: tokens added per second

REDIS_FAILURE_MODE=fail_open
# Options: fail_open | fail_closed
